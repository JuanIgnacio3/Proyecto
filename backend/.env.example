# === Plantilla de variables de entorno del backend ===
# Copie este archivo a `.env` y complete los valores.
# NUNCA committear el `.env` real (esta en .gitignore).

# === Base de datos (OBLIGATORIO) ===
# En produccion use un usuario y una contrasena FUERTES y unicos.
POSTGRES_USER=cambie_este_usuario
POSTGRES_PASSWORD=cambie_esta_contrasena_fuerte
POSTGRES_DB=tcu_db

# Cadena de conexion completa (debe coincidir con las credenciales de arriba).
# Host `db` = nombre del servicio de PostgreSQL en docker-compose.
DATABASE_URL=postgresql+psycopg2://cambie_este_usuario:cambie_esta_contrasena_fuerte@db:5432/tcu_db

# === Seguridad (OBLIGATORIO) ===
# Clave de firma de los JWT. La aplicacion NO arranca sin ella (minimo 32 chars).
# Genere una clave unica con:  openssl rand -hex 32
# No reutilice claves entre entornos. No use valores de ejemplo.
SECRET_KEY=

# Minutos de validez del token de acceso (opcional; por defecto 1440 = 24 h).
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie de sesion httpOnly. En PRODUCCION (HTTPS) debe ser true para que el
# navegador solo la envie por conexiones seguras. En desarrollo (HTTP) va false.
# COOKIE_SECURE=true

# === CORS (OBLIGATORIO en produccion) ===
# Origenes del frontend permitidos, separados por coma y sin espacios.
# Desarrollo:  http://localhost:5173
# Produccion:  https://midominio.cr,https://www.midominio.cr
BACKEND_CORS_ORIGINS=http://localhost:5173

# === Logging (opcional) ===
# DEBUG | INFO | WARNING | ERROR  (por defecto INFO)
LOG_LEVEL=INFO
